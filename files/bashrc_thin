# bashrc_thin — bash-specific: prompt, history behavior, conda. Concatenated
# after shellrc_common into ~/.bashrc's managed block at deploy time (see
# bootstrap.sh) — not sourced as a separate file.

# Prompt: cyan italic user, green host, bold yellow workdir
export PS1="\[\033[3;36m\]\u\[\033[m\]@\[\033[32m\]\h:\[\033[1;33m\]\w\[\033[m\]\$ "

# History: large, deduplicated, timestamped, appended after every command
# (bash has no built-in cross-terminal live sharing like zsh's SHARE_HISTORY,
# so PROMPT_COMMAND writes after every command instead)
export HISTCONTROL=ignoredups:erasedups
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTTIMEFORMAT="%Y-%m-%d %T "
shopt -s histappend
export PROMPT_COMMAND="history -a; ${PROMPT_COMMAND:-}"

# conda (no-op if not installed on this machine)
if [ -d "/opt/anaconda3" ]; then
    __conda_setup="$('/opt/anaconda3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    elif [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
        . "/opt/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="/opt/anaconda3/bin:$PATH"
    fi
    unset __conda_setup
fi
